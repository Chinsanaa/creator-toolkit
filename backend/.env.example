PORT=3001
FRONTEND_URL=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Enable Google and Apple under Supabase Dashboard → Authentication → Providers.
# Add redirect URL: http://localhost:3000/auth/callback (and your production URL).
ENABLE_SYNC_CRON=true
# In production, prefer external cron → POST /api/sync/cron (leave this false on the API service)
ENABLE_IN_PROCESS_SYNC_CRON=true
SYNC_CRON_SECRET=change-me-for-manual-cron-trigger
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Creator Toolkit <onboarding@resend.dev>
# OAuth for platform connections
# Redirect URI must match app configuration for each platform
# Local: http://localhost:3000/auth/{platform}-callback
# Production: https://your-domain.com/auth/{platform}-callback
BACKEND_REDIRECT_URI=http://localhost:3000/auth/tiktok-callback

# TikTok OAuth
# Get these from https://developers.tiktok.com/
TIKTOK_CLIENT_ID=your-tiktok-client-id
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# YouTube OAuth (via Google)
# Get these from https://console.cloud.google.com/
YOUTUBE_CLIENT_ID=your-youtube-client-id
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret

# Instagram OAuth (via Meta)
# Get these from https://developers.facebook.com/
INSTAGRAM_CLIENT_ID=your-instagram-client-id
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret
